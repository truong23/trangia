{
  "name": "deltagroup-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"yarn --cwd backend start:dev\" \"yarn --cwd frontend dev\"",
    "build": "yarn --cwd backend build && yarn --cwd frontend build",
    "install:all": "yarn --cwd backend install && yarn --cwd frontend install",
    "db:migrate": "yarn --cwd backend db:migrate",
    "db:migrate:rollback": "yarn --cwd backend db:migrate:rollback",
    "db:migration:create": "yarn --cwd backend db:migration:create",
    "db:migration:generate": "yarn --cwd backend db:migration:generate",
    "db:migrate:create": "yarn --cwd backend db:migrate:create",
    "db:migrate:generate": "yarn --cwd backend db:migrate:generate",
    "db:seed": "yarn --cwd backend db:seed",
    "db:refresh": "yarn --cwd backend db:refresh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pdf-parse": "1.1.1"
  }
}
